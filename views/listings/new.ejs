<% layout("/layouts/boilerplate") %>

  <body>
    <div class="row">
      <div class="col-8 offset-2 mt-3">
        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
          <h1>Create New Listing</h1>
          <div class="mb-3">
            <label for="title" class="form-label"  >Title</label>
            <input name="listing[title]" type="text" class="form-control" placeholder="Enter title" required>
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" placeholder="Enter description" required></textarea>
          </div>
          <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" class="form-control"  placeholder="Enter price" required>
          </div>
          <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input name="listing[image]" class="form-control" type="file">
          </div>
          <div class="row">
          <div class="mb-3 col-md-4" >
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" class="form-control" type="text" placeholder="Enter country" required>
          </div>
          <div class="mb-3 col-md-8">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" class="form-control" type="text" placeholder="Enter location" required>
          </div>
          </div>


          <button class="btn btn-dark">Add Listing</button>

        </form>
      </div>
    </div>

  </body>