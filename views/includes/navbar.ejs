<style>
  .btn-outline-success{
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
    color: white;
  }
  
  .btn-outline-success:hover{
    color: rgb(35, 224, 14);
    background-color: white !important;
  }
  .search-input{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }
</style>
<nav class="navbar navbar-expand-md bg-body-tertiary border-bottom sticky-top">
  <div class="container-fluid">

    <a class="navbar-brand" href="/listings">
      <i class="navbar-icon fa-solid fa-house"></i>
    </a>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">

      <!-- LEFT SIDE -->
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link active" href="/listings">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/listings">All Listings</a>
        </li>
        
      </ul>
<!-- Search bar -->
          <form class="d-flex ms-auto" role="search" action="/listings" method="GET">
            <input 
              class="form-control me-2 search-input"
              type="search"
              name="country"
              placeholder="Search by country"
            />
            <button class="btn btn-outline-success" type="submit">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
         </form>
      <!-- RIGHT SIDE -->
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="/listings/new">Airbnb your home</a>
        </li>
        <% if (!currUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/listings/signup">Sign Up</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/listings/login">Login</a>
          </li>
        <% } %>

        <% if (currUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/listings/logout">Logout</a>
          </li>
        <% } %>
      </ul>

    </div>
  </div>
</nav>